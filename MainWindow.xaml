    </Window.Resources>

    <Border x:Name="WindowRoot" CornerRadius="20" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.93" ScaleY="0.93"/>
                <TranslateTransform x:Name="WindowSlide" Y="22"/>
