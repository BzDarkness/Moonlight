        <Grid>
            <Grid x:Name="SkyHost" IsHitTestVisible="False">
            <!-- ===== CÉU: auroras, lua grande, estrelas (as animações são ligadas pelo código e podem pausar) ===== -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse CacheMode="BitmapCache" Width="560" Height="560" Canvas.Left="-200" Canvas.Top="260">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Acc1_48}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Acc1_00}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1T"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse CacheMode="BitmapCache" Width="520" Height="520" Canvas.Left="600" Canvas.Top="-170">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Acc2_38}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Acc2_00}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2T"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse CacheMode="BitmapCache" Width="440" Height="440" Canvas.Left="520" Canvas.Top="400">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource Acc3_33}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Acc3_00}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob3T"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
