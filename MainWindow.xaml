            <Path Data="{StaticResource MoonGeometry}" Fill="{DynamicResource AccentGradient}" Stretch="Uniform"
                  Width="420" Height="420" Opacity="0.08" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Margin="0,-70,-70,0" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MoonT"/>
                </Path.RenderTransform>
            </Path>

            <Canvas x:Name="StarCanvas" IsHitTestVisible="False"/>
            <Canvas x:Name="StarCanvasNear" IsHitTestVisible="False"/>
            <Canvas x:Name="SparkleCanvas" IsHitTestVisible="False"/>

            <!-- Estrelas cadentes -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="Shoot1" Width="90" Height="2" CornerRadius="1" Canvas.Left="180" Canvas.Top="90"
                        Opacity="0" RenderTransformOrigin="1,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#F0FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="28"/>
                            <TranslateTransform x:Name="Shoot1T"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="Shoot2" Width="70" Height="2" CornerRadius="1" Canvas.Left="640" Canvas.Top="150"
                        Opacity="0" RenderTransformOrigin="1,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource Acc2_00}" Offset="0"/>
                            <GradientStop Color="#F0DFF6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="28"/>
                            <TranslateTransform x:Name="Shoot2T"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Canvas>

            </Grid>

            <!-- ===== LAYOUT: barra lateral + conteúdo ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Barra lateral -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="96"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                            <Ellipse Width="90" Height="90" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{DynamicResource Acc1_55}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource Acc1_00}" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Image x:Name="SideLogo" Source="Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="LogoT"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <StackPanel x:Name="NavPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Play" IsChecked="True" Checked="Nav_Checked" Click="NavPlay_Click">
                                <StackPanel>
                                    <TextBlock Text="🎮" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Jogar" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Mods" Checked="Nav_Checked">
                                <StackPanel>
                                    <TextBlock Text="🧩" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mods" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Accounts" Checked="Nav_Checked">
                                <StackPanel>
                                    <TextBlock Text="👤" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Contas" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Skins" Checked="Nav_Checked">
                                <StackPanel>
                                    <TextBlock Text="🎨" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Skins" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Folders" Checked="Nav_Checked">
                                <StackPanel>
                                    <TextBlock Text="📁" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pastas" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SideNav}" GroupName="nav" Tag="Settings" Checked="Nav_Checked">
                                <StackPanel>
                                    <TextBlock Text="⚙" FontSize="21" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ajustes" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <RadioButton x:Name="GoldenNav" Style="{StaticResource SideNav}" GroupName="nav" Tag="Golden"
                                         Checked="Nav_Checked" ToolTip="Golden Moon">
                                <StackPanel>
                                    <Image Source="Assets/golden_moon.png" Width="30" Height="30" HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Golden Moon" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Margin="0,2,0,0" Foreground="#FFC94A"/>
                                </StackPanel>
                            </RadioButton>
                            <TextBlock x:Name="VersionText" FontSize="10" HorizontalAlignment="Center"
                                       Margin="0,6,0,4" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Conteúdo -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TitleRow" Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                        <StackPanel x:Name="TitleText" Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TitleTextT"/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="MOONLIGHT" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCHER" FontSize="17" FontWeight="Light" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentGradient}"/>
                        </StackPanel>
                        <!-- Mini barra: aparece no lugar do título quando as barras da aba Mods somem ao rolar -->
                        <Border x:Name="MiniBar" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0"
                                Padding="14,5" CornerRadius="14" Cursor="Hand" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource SurfaceHiBrush}" BorderBrush="{DynamicResource AccB1_80}"
                                BorderThickness="1" ToolTip="Mostrar a busca (ou role a rodinha para cima)"
                                MouseLeftButtonDown="MiniBar_Click">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MiniBarT" Y="10"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="MiniBarText" Text="Buscar mods" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Text="⌃" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource WinButton}" Content="—" Click="Minimize_Click"/>
                            <Button Style="{StaticResource WinButton}" Content="✕" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ================= PÁGINA: JOGAR ================= -->
                    <Grid x:Name="PagePlay" Grid.Row="1" Margin="26,0,26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="296"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="236"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="LoaderTitle" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock x:Name="LoaderDesc" FontSize="12.5" Foreground="{DynamicResource Muted}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center"/>
                                        <TextBlock Text="Verde = já baixada (abre direto, com qualquer conta)" FontSize="11.5"
                                                   Foreground="{DynamicResource GreenTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource MoonTextBox}"
                                                 TextChanged="SearchBox_TextChanged" ToolTip="Buscar versão (ex: 1.21)"/>
                                        <TextBlock Text="🔍  Buscar versão…" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Border Style="{StaticResource SegHost}" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="PlayViewList" Style="{StaticResource SegButton}" GroupName="playview" Tag="list"
                                                         Content="☰  Lista" Checked="PlayView_Checked"
                                                         ToolTip="Versões em botões simples"/>
                                            <RadioButton x:Name="PlayViewCards" Grid.Column="1" Style="{StaticResource SegButton}" GroupName="playview" Tag="cards"
                                                         Content="▦  Detalhado" Checked="PlayView_Checked"
                                                         ToolTip="Cartões com foto e banner do que cada versão traz"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <WrapPanel x:Name="LoaderPanel" Grid.Row="1" Margin="0,0,0,4">
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="Vanilla" IsChecked="True"
                                             GroupName="loader" Checked="Loader_Checked" Content="🌱  Vanilla"/>
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="OptiFine" GroupName="loader"
                                             Checked="Loader_Checked" Content="⚡  OptiFine"/>
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="Forge" GroupName="loader"
                                             Checked="Loader_Checked" Content="🔨  Forge"/>
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="Fabric" GroupName="loader"
                                             Checked="Loader_Checked" Content="🧵  Fabric"/>
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="NeoForge" GroupName="loader"
                                             Checked="Loader_Checked" Content="🦊  NeoForge"/>
                                <RadioButton Style="{StaticResource LoaderButton}" Tag="ForgeOptiFine" GroupName="loader"
                                             Checked="Loader_Checked" Content="🔨⚡  Forge + OptiFine"/>
                            </WrapPanel>

                            <Border x:Name="OptiBar" Grid.Row="2" Visibility="Collapsed" CornerRadius="10"
                                    Background="{DynamicResource AccB1_16}" BorderBrush="{DynamicResource AccB1_33}" BorderThickness="1"
                                    Padding="12,7" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                               Text="✨  O OptiFine já vem junto: é baixado e instalado sozinho na versão exata que você escolher."/>
                                    <Button x:Name="InstallOptiBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                            Content="📦  Usar meu .jar" Padding="10,5" Margin="12,0,0,0"
                                            ToolTip="Avançado: instalar um .jar do OptiFine que você já baixou"
                                            Click="InstallOptiFine_Click"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource VersionItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <!-- Visão DETALHADA: destaque da versão escolhida + cartões com banner (montados pelo código) -->
                                <Grid x:Name="VersionDetailView" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="HeroHost" Margin="0,0,0,10" Height="118"/>
                                    <ScrollViewer x:Name="VersionCardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" SizeChanged="VersionCardsScroll_SizeChanged">
                                        <WrapPanel x:Name="VersionCardsPanel"/>
                                    </ScrollViewer>
                                </Grid>
                                <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextAlignment="Center"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" FontSize="14"/>
                            </Grid>

                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                <TextBlock x:Name="StatusText" Text="Carregando versões…" FontSize="12"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,0,7"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="Progress" Style="{StaticResource MoonProgress}" Minimum="0" Maximum="1" Value="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Personagem 3D + conta + RAM + JOGAR -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid ClipToBounds="True" Margin="0,0,0,8">
                                    <Ellipse Width="250" Height="250" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="{DynamicResource Acc1_44}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource Acc1_00}" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="170" Height="26" VerticalAlignment="Bottom" Margin="0,0,0,10" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="{DynamicResource Acc2_88}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource Acc2_00}" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <local:SkinViewer3D x:Name="HomeSkinView"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="Conta ativa" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/>
                                    <Button x:Name="AccountButton" Style="{StaticResource GhostButton}" Margin="0"
                                            Padding="12,10" Click="AccountButton_Click">
                                        <TextBlock x:Name="ActiveAccountText" Text="Nenhuma conta"
                                                   TextTrimming="CharacterEllipsis" FontSize="13"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock x:Name="RamLabel" Text="Memória RAM: 4096 MB" FontSize="11"
                                               Foreground="{DynamicResource Muted}" Margin="2,0,0,8"/>
                                    <Slider x:Name="RamSlider" Style="{StaticResource MoonSlider}"
                                            Minimum="1024" Maximum="16384" Value="4096"
                                            TickFrequency="512" IsSnapToTickEnabled="True"
                                            ValueChanged="RamSlider_ValueChanged"/>
                                </StackPanel>

                                <Button x:Name="PlayButton" Grid.Row="3" Style="{StaticResource HeroPlayButton}"
                                        Content="▶  JOGAR" Height="58" Margin="0,16,0,0" IsEnabled="False"
                                        Click="Play_Click"/>
                                <Button x:Name="FriendsOpenBtn" Grid.Row="4" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                        Padding="12,11" Click="FriendsOpen_Click" ToolTip="Jogue com seus amigos, converse e entre nos mundos deles">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Amigos e conversas" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border x:Name="FriendsBadge" Visibility="Collapsed" Margin="10,0,0,0" MinWidth="20" Height="20"
                                                CornerRadius="10" Padding="6,0" Background="{DynamicResource AccentGradient}">
                                            <TextBlock x:Name="FriendsBadgeText" Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PÁGINA: AMIGOS (estilo app de mensagens) ================= -->
                    <Grid x:Name="PageFriends" Grid.Row="1" Margin="26,0,26,22" Visibility="Collapsed">
                        <Grid.Resources>
                            <!-- Botão redondo só com ícone -->
                            <Style x:Key="IconBtn" TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Margin" Value="4,0,0,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="18" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHiBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Botão redondo de enviar -->
                            <Style x:Key="RoundSend" TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Width" Value="44"/>
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="22" Background="{DynamicResource AccentGradient}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Linha da lista de conversas -->
                            <Style x:Key="FriendItem" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccB1_33}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Item da lista de conversas -->
                            <DataTemplate x:Key="FriendTemplate">
                                <Grid x:Name="Root">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="50" Height="50" Margin="0,0,12,0">
                                        <Border CornerRadius="25">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Face}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,-1,-1" StrokeThickness="2.5" Stroke="{DynamicResource SurfaceBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#6B6F85"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="online">
                                                            <Setter Property="Fill" Value="#3DDC84"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="dnd">
                                                            <Setter Property="Fill" Value="#FFB020"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastTime}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GreenTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWorld}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GreenTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0"
                                                        Background="{DynamicResource AccentGradient}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Content="▶" Style="{StaticResource PlayButton}" FontSize="11" Padding="9,3" Margin="8,0,0,0"
                                                        ToolTip="Entrar no mundo deste amigo" Tag="{Binding}" Click="FriendJoin_Click">
                                                    <Button.Visibility>
                                                        <Binding Path="HasWorld">
                                                            <Binding.Converter>
                                                                <BooleanToVisibilityConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Button.Visibility>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <!-- Resultado da busca -->
                            <DataTemplate x:Key="ResultTemplate">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Face}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border CornerRadius="6" Padding="6,1" Background="{DynamicResource AccB1_33}">
                                                <TextBlock Text="{Binding AccLabel}" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource Text2Brush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Code}" FontSize="10.5" FontFamily="Consolas" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding Action}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Padding="10,6" FontSize="12" Tag="{Binding}" IsEnabled="{Binding CanAdd}" Click="FriendAdd_Click"/>
                                </Grid>
                            </DataTemplate>

                            <!-- Pedido de amizade recebido -->
                            <DataTemplate x:Key="RequestTemplate">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Face}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="quer ser seu amigo" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="✔" Style="{StaticResource PlayButton}" FontSize="13" Padding="11,6" Margin="6,0,0,0"
                                                ToolTip="Aceitar" Tag="{Binding}" Click="FriendAccept_Click"/>
                                        <Button Content="✖" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,6" Margin="6,0,0,0"
                                                ToolTip="Recusar" Tag="{Binding}" Click="FriendDecline_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <!-- Balão do chat -->
                            <DataTemplate x:Key="ChatTemplate">
                                <Border x:Name="Bubble" MaxWidth="440" Padding="12,7,12,6" Margin="0,2" HorizontalAlignment="Left"
                                        CornerRadius="14,14,14,3" Background="{DynamicResource SurfaceHiBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="Msg" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="Clock" Text="{Binding Time}" FontSize="10" Margin="0,2,0,0"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Mine}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Bubble" Property="CornerRadius" Value="14,14,3,14"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                        <Setter TargetName="Msg" Property="Foreground" Value="White"/>
                                        <Setter TargetName="Clock" Property="Foreground" Value="#CCFFFFFF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- barra de cima -->
                        <Grid Margin="0,0,0,10">
                            <Button Content="←  Voltar" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0" Padding="12,6" FontSize="12.5" Click="FriendsBack_Click"/>
                            <TextBlock Text="💬  Amigos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- "janela" do app de mensagens -->
                        <Border Grid.Row="1" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource CardBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ============ Coluna da esquerda: conversas ============ -->
                                <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LineBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- cabeçalho: eu -->
                                        <Grid Margin="14,14,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="MeFace" Width="46" Height="46" CornerRadius="23" Margin="0,0,12,0"
                                                    BorderThickness="2" BorderBrush="{DynamicResource AccB1_FF}">
                                                <Border.Background>
                                                    <ImageBrush x:Name="MeFaceBrush" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="MeName" Text="Jogador" FontSize="15.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#6B6F85" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ConnText" Text="Desconectado" FontSize="11.5" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="➕" Style="{StaticResource IconBtn}" ToolTip="Adicionar amigo" Click="NewFriend_Click"/>
                                                <Button Content="⋯" Style="{StaticResource IconBtn}" FontSize="20" FontWeight="Bold"
                                                        ToolTip="Meu código, não perturbe e meu mundo" Click="MenuToggle_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <!-- ===== lista de conversas ===== -->
                                            <Grid x:Name="ChatListView">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- menu: código, não perturbe, meu mundo -->
                                                <Border x:Name="MenuPanel" Visibility="Collapsed" Margin="14,0,14,10" Padding="12"
                                                        CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="SEU CÓDIGO DE AMIGO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock x:Name="MeCode" Text="MOON-·····-·····" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                                                           Margin="0,2,0,0" Foreground="{DynamicResource TextStrongBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="📋" Style="{StaticResource IconBtn}" ToolTip="Copiar o código" Click="CopyCode_Click"/>
                                                        </Grid>

                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🌙  Não perturbe" FontSize="12.5" VerticalAlignment="Center"
                                                                       ToolTip="Sem janelinha e sem som quando alguém falar com você"/>
                                                            <ToggleButton x:Name="DndToggle" Grid.Column="1" Style="{StaticResource ModSwitch}" Click="DndToggle_Click"/>
                                                            <TextBlock Grid.Column="2" Text="🔔" FontSize="14" Margin="14,0,6,0" VerticalAlignment="Center"
                                                                       ToolTip="Som de notificação"/>
                                                            <ToggleButton x:Name="SoundToggle" Grid.Column="3" Style="{StaticResource ModSwitch}" Click="SoundToggle_Click"/>
                                                        </Grid>

                                                        <Rectangle Height="1" Margin="0,12,0,10" Fill="{DynamicResource LineBrush}"/>

                                                        <TextBlock Text="🌍  Meu mundo" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="MyWorldText" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,8"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   Text="Abra um mundo no Minecraft e use “Abrir para LAN”. Ele aparece sozinho para seus amigos."/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="MyWorldPort" Style="{StaticResource MoonTextBox}" FontSize="12.5" Padding="9,7"
                                                                     MaxLength="5" ToolTip="Porta do seu mundo (aparece no chat do jogo ao abrir para LAN)"/>
                                                            <Button x:Name="MyWorldBtn" Grid.Column="1" Content="Compartilhar" Style="{StaticResource GhostButton}"
                                                                    Margin="8,0,0,0" Padding="12,7" FontSize="12.5" Click="MyWorldShare_Click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- pesquisar conversas -->
                                                <Border Grid.Row="1" Margin="14,0,14,10" CornerRadius="20" Padding="12,0"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="🔎" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                                                        <TextBox x:Name="FriendFilter" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccB1_FF}"
                                                                 FontSize="13" Padding="0,9" MaxLength="24" VerticalContentAlignment="Center"
                                                                 TextChanged="FriendFilter_TextChanged"/>
                                                        <TextBlock x:Name="FriendFilterHint" Grid.Column="1" Text="Pesquisar nas conversas" FontSize="13"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- pedidos recebidos -->
                                                <Border x:Name="RequestsCard" Grid.Row="2" Visibility="Collapsed" Margin="14,0,14,10"
                                                        Padding="12,10,12,2" CornerRadius="14" Background="{DynamicResource AccB1_33}"
                                                        BorderBrush="{DynamicResource AccB1_FF}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="📨  Pedidos de amizade" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                        <ItemsControl x:Name="RequestList" ItemTemplate="{StaticResource RequestTemplate}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- conversas -->
                                                <Grid Grid.Row="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="FriendsCountText" Text="Conversas" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,6"
                                                               Foreground="{DynamicResource Muted}"/>
                                                    <ListBox x:Name="FriendList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                             ItemContainerStyle="{StaticResource FriendItem}" ItemTemplate="{StaticResource FriendTemplate}"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="FriendList_SelectionChanged"/>
                                                    <StackPanel x:Name="FriendsEmptyText" Grid.Row="1" Visibility="Collapsed" Margin="24,28,24,0"
                                                                VerticalAlignment="Top" HorizontalAlignment="Center">
                                                        <TextBlock Text="👥" FontSize="38" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Nenhuma conversa ainda" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,14"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   Text="Passe seu código para um amigo ou procure o nome dele. Vale conta Microsoft ou offline. 🌙"/>
                                                        <Button Content="➕  Adicionar amigo" Style="{StaticResource PlayButton}" FontSize="13" Padding="18,9"
                                                                HorizontalAlignment="Center" Click="NewFriend_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- ===== painel: adicionar amigo ===== -->
                                            <Grid x:Name="AddPanel" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Margin="10,0,14,10">
                                                    <Button Content="←" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" FontSize="18"
                                                            ToolTip="Voltar para as conversas" Click="AddBack_Click"/>
                                                    <TextBlock Text="Novo amigo" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Border Grid.Row="1" Margin="14,0,14,6" CornerRadius="20" Padding="14,0,4,0"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="AddBox" Background="Transparent" BorderThickness="0"
                                                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccB1_FF}"
                                                                 FontSize="13" Padding="0,10" MaxLength="24" VerticalContentAlignment="Center"
                                                                 KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged"/>
                                                        <TextBlock x:Name="AddBoxHint" Text="Código (MOON-…) ou nome do amigo" FontSize="13"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
                                                        <Button Grid.Column="1" Content="🔎" Style="{StaticResource IconBtn}" Margin="4" ToolTip="Procurar"
                                                                Click="FriendSearch_Click"/>
                                                    </Grid>
                                                </Border>

                                                <TextBlock x:Name="AddStatus" Grid.Row="2" FontSize="11.5" TextWrapping="Wrap" Margin="18,2,18,8"
                                                           Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>

                                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="14,4,8,0">
                                                    <StackPanel Margin="0,0,6,12">
                                                        <ItemsControl x:Name="SearchList" ItemTemplate="{StaticResource ResultTemplate}"/>
                                                        <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="Como adicionar" FontSize="12.5" FontWeight="SemiBold"/>
                                                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"
                                                                           Text="Peça o código do seu amigo (MOON-…) ou digite o nome dele. Quando ele aceitar, vocês já podem conversar e entrar nos mundos um do outro."/>
                                                                <TextBlock Text="SEU CÓDIGO" FontSize="9" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource Muted}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="AddPanelCode" Text="MOON-·····-·····" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextStrongBrush}"/>
                                                                    <Button Grid.Column="1" Content="📋" Style="{StaticResource IconBtn}" ToolTip="Copiar o código" Click="CopyCode_Click"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ============ Coluna da direita: conversa ============ -->
                                <Grid Grid.Column="1">
                                    <StackPanel x:Name="ChatEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                                        <TextBlock Text="🌙" FontSize="58" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Moonlight Amigos" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="Converse, veja quem está online e entre nos mundos dos seus amigos com um clique. Escolha uma conversa ao lado para começar."
                                                   FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <Border Margin="0,18,0,0" Padding="16,10" CornerRadius="14" HorizontalAlignment="Center"
                                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="SEU CÓDIGO DE AMIGO" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}"/>
                                                <TextBlock x:Name="EmptyCode" Text="MOON-·····-·····" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextStrongBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="📋  Copiar código" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                                HorizontalAlignment="Center" Padding="16,8" FontSize="12.5" Click="CopyCode_Click"/>
                                        <TextBlock x:Name="ConnDetail" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="11.5" Margin="0,16,0,0" Foreground="#FFB020"/>
                                    </StackPanel>

                                    <Grid x:Name="ChatPane" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- cabeçalho do amigo -->
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="16,10,12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,12,0">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="ChatFaceBrush" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ChatName" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border CornerRadius="6" Padding="6,1" Background="{DynamicResource AccB1_33}">
                                                            <TextBlock x:Name="ChatAcc" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}"/>
                                                        </Border>
                                                        <TextBlock x:Name="ChatStatus" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Muted}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="🗑" Style="{StaticResource IconBtn}" ToolTip="Remover amigo" Click="FriendRemove_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- mundo do amigo -->
                                        <Border x:Name="WorldPanel" Grid.Row="1" Margin="14,10,14,0" Padding="14,10" CornerRadius="14"
                                                BorderThickness="1" BorderBrush="{DynamicResource AccB1_FF}" Visibility="Collapsed"
                                                Background="{DynamicResource AccB1_33}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="WorldTitle" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="WorldSub" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Text2Brush}"/>
                                                    <TextBlock x:Name="WorldHint" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Muted}"/>
                                                </StackPanel>
                                                <Button x:Name="WorldJoinBtn" Grid.Column="1" Content="▶  Entrar no mundo" Style="{StaticResource PlayButton}"
                                                        FontSize="13.5" Padding="18,10" Margin="14,0,0,0" Click="WorldJoin_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- mensagens (fundo mais escuro, como num app de mensagens) -->
                                        <Border Grid.Row="2" Margin="0,10,0,0" Background="#14000000">
                                            <ScrollViewer x:Name="ChatScroll" Margin="16,8,10,0" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="ChatItems" ItemTemplate="{StaticResource ChatTemplate}" Margin="0,4,6,8"/>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock x:Name="TypingText" Grid.Row="3" Margin="20,4,18,0" FontSize="11.5" Height="16"
                                                   FontStyle="Italic" Foreground="{DynamicResource Muted}"/>

                                        <!-- escrever mensagem -->
                                        <Grid Grid.Row="4" Margin="14,6,14,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="22" Padding="18,0" MinHeight="44"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                <Grid>
                                                    <TextBox x:Name="ChatInput" Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccB1_FF}"
                                                             FontSize="14" Padding="0,11" MaxLength="500" VerticalContentAlignment="Center"
                                                             KeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged"/>
                                                    <TextBlock x:Name="ChatInputHint" Text="Digite uma mensagem" FontSize="14" VerticalAlignment="Center"
                                                               IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" Content="➤" Style="{StaticResource RoundSend}" Margin="10,0,0,0" Click="ChatSend_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PÁGINA: MODS ================= -->
                    <Grid x:Name="PageMods" Grid.Row="1" Margin="26,0,26,22" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="DrawerCol" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gaveta: mods que já estão na pasta (abre e fecha pela setinha na borda direita) -->
                    <Grid x:Name="DrawerClip" Grid.Column="1" ClipToBounds="True" Visibility="Collapsed">
                    <Border x:Name="DrawerPanel" Width="272" HorizontalAlignment="Left" Margin="18,0,0,0" CornerRadius="14"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14,14,8,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,6,0">
                                <TextBlock Text="MODS INSTALADOS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="↻" Width="32" Height="28" Padding="0" Margin="0,0,6,0"
                                            ToolTip="Atualizar a lista" Click="InstalledRefresh_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="📁" Width="32" Height="28" Padding="0" Margin="0"
                                            ToolTip="Abrir a pasta mods" Click="InstalledFolder_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="InstalledSummary" Grid.Row="1" FontSize="12" Margin="0,8,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="InstalledList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource InstalledModItem}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="InfoBox" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1" Style="{StaticResource ModSwitch}"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}" Tag="{Binding}"
                                                              ToolTip="Ativar / desativar este mod" Click="ModToggle_Click"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter TargetName="InfoBox" Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="InstalledEmpty" Visibility="Collapsed" TextAlignment="Center"
                                           TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="12,0,12,0" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Text="Nenhum mod instalado ainda.&#x0A;Instale pela busca ao lado ou coloque os .jar na pasta mods."/>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>

                    <!-- Busca e instalação -->
                    <Grid x:Name="ModsBrowse" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-abas -->
                    <local:RevealHost x:Name="RevealTabs" Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource NavTab}" GroupName="modtype" Tag="mod" IsChecked="True"
                                     Content="🧩  Mods" Checked="ModsType_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="modtype" Tag="modpack"
                                     Content="📦  Modpacks" Checked="ModsType_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="modtype" Tag="resourcepack"
                                     Content="🖼  Texturas" Checked="ModsType_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="modtype" Tag="shader"
                                     Content="✨  Shaders" Checked="ModsType_Checked"/>
                        <RadioButton x:Name="PackTab" Style="{StaticResource NavTab}" GroupName="modtype" Tag="mypacks"
                                     Content="🎒  Meus modpacks" Checked="ModsType_Checked"/>
                    </StackPanel>
                    </local:RevealHost>

                    <!-- Busca e filtros -->
                    <local:RevealHost x:Name="RevealFilter" Grid.Row="1">
                    <Border x:Name="ModsFilterRow" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12" CornerRadius="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModsSearchBox" Style="{StaticResource MoonTextBox}" Margin="0,0,10,0"
                                         ToolTip="Buscar (ex: sodium, jei, shaders…)" KeyDown="ModsBox_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource PlayButton}" Content="🔍  Buscar"
                                        FontSize="13" Padding="22,10" Margin="0" Click="ModsSearch_Click"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Versão" FontSize="12" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Width="124">
                                        <TextBox x:Name="ModsMcBox" Style="{StaticResource MoonTextBox}" Padding="12,7,34,7" FontSize="13"
                                                 ToolTip="Digite a versão (ex: 1.20.1) ou toque na seta para ver todas. Vazio = tudo."
                                                 KeyDown="ModsBox_KeyDown"/>
                                        <Button x:Name="ModsMcArrow" Style="{StaticResource WinButton}" Content="▾" Width="28" Height="26"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                ToolTip="Ver todas as versões disponíveis"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="ModsLoaderPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modloader" Tag="fabric"
                                                 IsChecked="True" Content="Fabric" Checked="ModsLoader_Checked"/>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modloader" Tag="forge"
                                                 Content="Forge" Checked="ModsLoader_Checked"/>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modloader" Tag="neoforge"
                                                 Content="NeoForge" Checked="ModsLoader_Checked"/>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modloader" Tag="quilt"
                                                 Content="Quilt" Checked="ModsLoader_Checked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Baixar de" FontSize="12" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modsrc" Tag="Modrinth"
                                                 IsChecked="True" Content="Modrinth" Checked="ModsSource_Checked"/>
                                    <RadioButton Style="{StaticResource PillButton}" GroupName="modsrc" Tag="CurseForge"
                                                 Margin="0" Content="CurseForge" Checked="ModsSource_Checked"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    </local:RevealHost>

                    <!-- Faixa do modpack, temas e chave do CurseForge -->
                    <local:RevealHost x:Name="RevealExtra" Grid.Row="2">
                    <StackPanel x:Name="ModsExtraRow">
                    <Border x:Name="PackModeBar" Visibility="Collapsed" CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                            Background="{DynamicResource AccB1_33}" BorderBrush="{DynamicResource AccB1_80}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PackModeText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✔  Concluir" Padding="14,7"
                                    Margin="12,0,0,0" Click="PackModeDone_Click"/>
                        </Grid>
                    </Border>
                    <!-- Barra de ferramentas dos resultados: ordenar, sugestões e modo de exibição -->
                    <Grid x:Name="ModsToolbar" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ordenar" FontSize="12" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="SortBtn" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Relevância  ▾"
                                Padding="14,7" Margin="0,0,10,0" MinWidth="150" Click="SortBtn_Click"/>
                        <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortBtn}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="4,6,16,16" Padding="6" CornerRadius="12" MinWidth="200"
                                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                </Border.Effect>
                                <StackPanel x:Name="SortMenuHost"/>
                            </Border>
                        </Popup>

                        <Button x:Name="TopicsBar" Grid.Column="2" Style="{StaticResource GhostButton}" Content="💡  Sugestões  ▾"
                                Padding="14,7" Margin="0" Click="TopicsBtn_Click"/>
                        <Popup x:Name="TopicsPopup" PlacementTarget="{Binding ElementName=TopicsBar}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="4,6,16,16" Padding="14,12" CornerRadius="14" Width="500"
                                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="💡  Sugestões por tema — escolha um ou mais" FontSize="12"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Limpar" Padding="12,4" Margin="0"
                                                HorizontalAlignment="Right" Click="TopicsClear_Click"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="TopicsPanel"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Modo" FontSize="12" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Style="{StaticResource SegHost}" Width="236">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModsViewList" Style="{StaticResource SegButton}" GroupName="modsview" Tag="list"
                                                 IsChecked="True" Content="☰  Lista" Checked="ModsView_Checked"/>
                                    <RadioButton x:Name="ModsViewCards" Grid.Column="1" Style="{StaticResource SegButton}" GroupName="modsview" Tag="cards"
                                                 Content="▦  Detalhado" Checked="ModsView_Checked"
                                                 ToolTip="Cartões grandes com banner, foto, descrição e etiquetas"/>
                                </Grid>
                            </Border>
                            </StackPanel>
                    </Grid>
                    <!-- Só aparece se o CurseForge recusar a chave que vem dentro do launcher -->
                    <Border x:Name="CfBar" Visibility="Collapsed" CornerRadius="12" Padding="14,12" Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccB1_80}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔑  O CurseForge recusou a chave do launcher. Cole uma chave sua (é grátis):"
                                       FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="CfKeyBox" Style="{StaticResource MoonPasswordBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource PlayButton}" Content="Salvar" FontSize="13"
                                        Padding="20,9" Margin="0,0,8,0" Click="CfSaveKey_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="🔑  Pegar chave grátis"
                                        Padding="14,9" Margin="0" Click="CfGetKey_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </local:RevealHost>

                    <!-- Resultados -->
                    <Grid x:Name="ModsResultsGrid" Grid.Row="3" SizeChanged="ModsResults_SizeChanged"
                          PreviewMouseWheel="ModsResults_PreviewWheel" ScrollViewer.ScrollChanged="ModsResults_ScrollChanged">
                        <ListBox x:Name="ModsList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ModItem}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2" Margin="0,2,12,2" Background="{Binding Accent.Strip}"/>
                                        <Border Grid.Column="1" Width="52" Height="52" CornerRadius="10" VerticalAlignment="Center"
                                                Background="{Binding Accent.Strip}">
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UrlImg}, ConverterParameter=104}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,2"
                                                       Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" MaxHeight="34"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Content="🌐" Tag="{Binding}"
                                                    ToolTip="Abrir no site" Width="40" Height="38" Padding="0" Margin="0,0,8,0"
                                                    Click="ModsOpenPage_Click"/>
                                            <Button Style="{StaticResource PlayButton}" Content="{Binding ActionLabel}"
                                                    Tag="{Binding}" FontSize="13" Width="134" Height="38" Padding="0" Margin="0"
                                                    Click="ModsInstall_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="ModsCards" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="58"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Faixa fina do topo, colada nas bordas: banner do mod ou, sem banner, a cor da foto -->
                                        <Border CornerRadius="13,13,0,0" Background="{Binding Accent.Strip}"/>
                                        <Border CornerRadius="13,13,0,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding BannerUrl, Converter={StaticResource UrlImg}, ConverterParameter=640}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="13,13,0,0" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.35"/>
                                                    <GradientStop Color="#70000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                                                CornerRadius="8" Padding="8,2" Background="#A0000000">
                                            <TextBlock Text="{Binding Source}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>

                                        <Grid Grid.Row="1" Margin="14,0,14,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="64" Height="64" CornerRadius="15" Margin="0,-32,0,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBrush}"
                                                        BorderThickness="3">
                                                    <Grid>
                                                        <Border CornerRadius="12" Background="{Binding Accent.Strip}"/>
                                                        <Border CornerRadius="12">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UrlImg}, ConverterParameter=128}"
                                                                            Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,8,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                    <TextBlock Text="{Binding Author, StringFormat=por {0}}" FontSize="11.5"
                                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap"
                                                       MinHeight="48" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}"/>

                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding TagList}" Margin="0,10,0,0" MinHeight="26">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" Padding="8,2" Margin="0,0,6,4" BorderThickness="1"
                                                                Background="{Binding DataContext.Accent.Soft, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                BorderBrush="{Binding DataContext.Accent.Edge, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                            <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Text2Brush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DownloadsText, StringFormat=⬇ {0}}" FontSize="11.5"
                                                               Foreground="{DynamicResource Text2Brush}" Margin="0,1,12,1"/>
                                                    <TextBlock Text="{Binding FollowsText, StringFormat=♥ {0}}" FontSize="11.5"
                                                               Foreground="{DynamicResource Text2Brush}" Margin="0,1,12,1"
                                                               Visibility="{Binding HasFollows, Converter={StaticResource B2V}}"/>
                                                    <TextBlock Text="{Binding UpdatedText}" FontSize="11.5" Margin="0,1,0,1"
                                                               Foreground="{DynamicResource Muted}"/>
                                                </WrapPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}" Content="🌐" Tag="{Binding}"
                                                            ToolTip="Abrir no site" Width="38" Height="34" Padding="0" Margin="0,0,8,0"
                                                            Click="ModsOpenPage_Click"/>
                                                    <Button Style="{StaticResource PlayButton}" Content="{Binding ActionLabel}"
                                                            Tag="{Binding}" FontSize="12.5" Width="124" Height="34" Padding="0" Margin="0"
                                                            Click="ModsInstall_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModsEmpty" Visibility="Collapsed" Text="Nada encontrado. Tente outra busca ou outra versão."
                                   TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" FontSize="14"/>
                    </Grid>

                    <StackPanel x:Name="ModsPager" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="ModsStatus" Grid.Row="5" FontSize="12" Foreground="{DynamicResource Muted}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- ===== MEUS MODPACKS (criar, guardar e jogar) ===== -->
                    <Grid x:Name="ModpackPanel" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MEUS MODPACKS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" Margin="4,0,0,10"/>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="PackList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource AccountItem}"
                                         SelectionChanged="PackList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="PackEmpty" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"
                                           Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Text="Você ainda não criou nenhum modpack.&#x0A;Clique em “Novo modpack”."/>
                            </Grid>
                            <Button Grid.Row="2" Style="{StaticResource PlayButton}" Content="➕  Novo modpack" FontSize="13"
                                    Padding="14,10" Margin="0,10,0,0" Click="PackNew_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <Border x:Name="PackForm" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Criar modpack" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                                   Margin="0,6,0,14"
                                                   Text="Dê um nome, escolha a versão do Minecraft e o loader. Depois é só adicionar os mods que quiser."/>
                                        <TextBlock Text="Nome" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,6"/>
                                        <TextBox x:Name="PackNameBox" Style="{StaticResource MoonTextBox}" MaxLength="40"/>
                                        <TextBlock Text="Versão do Minecraft" FontSize="12" Foreground="{DynamicResource Muted}"
                                                   Margin="2,12,0,6"/>
                                        <Grid Width="170" HorizontalAlignment="Left">
                                            <TextBox x:Name="PackMcBox" Style="{StaticResource MoonTextBox}" Padding="12,9,34,9"
                                                     ToolTip="Digite a versão ou toque na seta"/>
                                            <Button x:Name="PackMcArrow" Style="{StaticResource WinButton}" Content="▾" Width="28" Height="28"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                                    ToolTip="Ver todas as versões disponíveis"/>
                                        </Grid>
                                        <TextBlock Text="Loader" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,12,0,6"/>
                                        <WrapPanel x:Name="PackLoaderPanel">
                                            <RadioButton Style="{StaticResource PillButton}" GroupName="packloader" Tag="fabric"
                                                         IsChecked="True" Content="Fabric" Checked="PackLoader_Checked"/>
                                            <RadioButton Style="{StaticResource PillButton}" GroupName="packloader" Tag="forge"
                                                         Content="Forge" Checked="PackLoader_Checked"/>
                                            <RadioButton Style="{StaticResource PillButton}" GroupName="packloader" Tag="neoforge"
                                                         Content="NeoForge" Checked="PackLoader_Checked"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Style="{StaticResource PlayButton}" Content="✔  Criar modpack" FontSize="14"
                                                    Padding="18,9" Margin="0,0,10,0" Click="PackCreate_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Cancelar" Margin="0"
                                                    Click="PackCancel_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="PackFormStatus" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="PackDetail" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="PackTitle" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="PackSub" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                                        <WrapPanel Margin="0,14,0,6">
                                            <Button x:Name="PackPlayBtn" Style="{StaticResource PlayButton}" Content="▶  Jogar com este modpack"
