                                        </StackPanel>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,6,0,10"
                                               Text="Quando uma nova versão é publicada, o launcher avisa, baixa e reinicia sozinho com os recursos novos, sem instalar nada extra no PC. Com a opção desligada, ele só avisa e você escolhe quando atualizar."/>
                                    <TextBlock x:Name="UpdateVersionText" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" Margin="2,0,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="🔎  Verificar atualização agora"
                                                Margin="0,0,8,8" Click="CheckUpdateNow_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🌙  O que deixa o launcher leve" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5" LineHeight="20"
                                               Margin="0,10,0,0"
                                               Text="•  Minimizado ou jogando: todas as animações e o boneco 3D param por completo.&#x0A;•  O boneco 3D só desenha quando está na tela e fica parado (sem gastar nada) se o mouse não se mexe.&#x0A;•  As estrelas são desenhadas em poucas camadas, não uma por uma.&#x0A;•  Ao abrir o jogo, o launcher devolve a memória que não usa para o Windows.&#x0A;•  Modo Leve: menos estrelas, sem auroras em movimento, 3D mais simples e animações a 24 quadros (valem por completo ao reabrir).&#x0A;•  O OptiFine e a lista de versões ficam em cache: nada é baixado duas vezes."/>
                                </StackPanel>
                            </Border>
                        
                            </StackPanel>
                            <StackPanel x:Name="SettingsCustomize" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="2,0,0,12"
                                       Text="Deixe o launcher com a sua cara: temas, paletas de cores e ícones."/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🎨  Temas" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                               Margin="0,6,0,14"
                                               Text="Muda o launcher inteiro: fundo, cartões, menus e botões se adaptam ao tema escolhido."/>
                                    <WrapPanel x:Name="ThemePanel">
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Default" GroupName="theme"
                                                     Content="🌙  Padrão" Checked="ThemeChoice_Checked"/>
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Light" GroupName="theme"
                                                     Content="☀  Claro" Checked="ThemeChoice_Checked"/>
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Dark" GroupName="theme"
                                                     Content="🌓  Escuro" Checked="ThemeChoice_Checked"/>
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Midnight" GroupName="theme"
                                                     Content="🌌  Midnight" Checked="ThemeChoice_Checked"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ThemeInfo" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                               Margin="2,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <StackPanel x:Name="PaletteBox">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="Assets/golden_moon.png" Width="24" Height="24" Margin="0,0,10,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Paletas Golden Moon" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Usar minhas paletas" FontSize="12" Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ToggleButton x:Name="PaletteToggle" Style="{StaticResource ModSwitch}" Click="PaletteToggle_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,6,0,12"
                                                   Text="Escolha duas cores. O launcher ganha um degradê entre elas no fundo, nos botões e nos detalhes."/>
                                        <Border x:Name="PalettePreview" Height="30" CornerRadius="10" Margin="0,0,0,14"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                        <StackPanel x:Name="PaletteHost"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Style="{StaticResource PlayButton}" Content="💾  Salvar paletas" FontSize="14"
                                                    Padding="18,9" Margin="0,0,10,8" Click="PaletteSave_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="↺  Voltar ao padrão"
                                                    Margin="0,0,8,8" Click="PaletteReset_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border x:Name="PaletteLock" CornerRadius="14" Background="{DynamicResource PopupBrush}" Opacity="0.96">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                            <Image Source="Assets/golden_moon.png" Width="44" Height="44" HorizontalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="🔒  Paletas personalizadas são exclusivas do Golden Moon" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,4"/>
                                            <TextBlock Text="Assine para criar o seu degradê de duas cores." FontSize="12.5"
                                                       Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,0,0,12"/>
                                            <Button Style="{StaticResource PlayButton}" Content="Conhecer o Golden Moon" FontSize="13"
                                                    Padding="18,9" HorizontalAlignment="Center" Click="GoldenLock_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <StackPanel x:Name="IconBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/golden_moon.png" Width="24" Height="24" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Ícones Golden Moon" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,6,0,14"
                                                   Text="Troque o ícone do aplicativo (janela e barra de tarefas) e a mini lua do launcher por um destes desenhos. O ícone do arquivo .exe no Windows continua o original."/>
                                        <TextBlock Text="ÍCONE DO APLICATIVO" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}" Margin="2,0,0,8"/>
                                        <WrapPanel x:Name="IconAppHost"/>
                                        <TextBlock Text="MINI LUA (barra lateral e abertura)" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}" Margin="2,6,0,8"/>
                                        <WrapPanel x:Name="IconMoonHost"/>
                                        <TextBlock x:Name="IconInfo" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                                   Margin="2,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border x:Name="IconLock" CornerRadius="14" Background="{DynamicResource PopupBrush}" Opacity="0.96">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                            <Image Source="Assets/golden_moon.png" Width="44" Height="44" HorizontalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="🔒  Trocar os ícones é exclusivo do Golden Moon" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,4"/>
                                            <TextBlock Text="Assine para escolher um dos 6 ícones para o aplicativo e para a mini lua." FontSize="12.5"
                                                       Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <Button Style="{StaticResource PlayButton}" Content="Conhecer o Golden Moon" FontSize="13"
                                                    Padding="18,9" HorizontalAlignment="Center" Click="GoldenLock_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>


                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= PÁGINA: GOLDEN MOON ================= -->
                    <ScrollViewer x:Name="PageGolden" Grid.Row="1" Margin="26,0,12,22" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <Border Style="{StaticResource Card}" Padding="26">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="140" Height="140" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Ellipse Width="180" Height="180" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#66FFC94A" Offset="0"/>
                                                    <GradientStop Color="#00FFC94A" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Image Source="Assets/golden_moon.png" Width="118" Height="118"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Golden Moon" FontSize="32" FontWeight="Bold" Foreground="#FFC94A"/>
                                        <TextBlock x:Name="GoldenStatus" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,8,0,0"
                                                   Text="A assinatura do Moonlight Launcher. Deixe o launcher com a sua cara."/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="✨  Benefícios de assinar" FontSize="17" FontWeight="Bold"/>
                                    <Border CornerRadius="12" Padding="16" Margin="0,12,0,0" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🎨  Tema personalizado com 2 paletas de cores" FontSize="15" FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5"
                                                           Margin="0,6,0,0"
                                                           Text="Escolha duas cores e o launcher inteiro ganha um degradê só seu: fundo, botões, abas e detalhes. Funciona junto com os temas Padrão, Claro, Escuro e Midnight."/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Height="64" CornerRadius="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFD54F" Offset="0"/>
                                                        <GradientStop Color="#FF8F00" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                                                    <Border CornerRadius="12" Padding="16" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🎭  Criador de skin completo" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5"
                                                       Margin="0,6,0,0" Text="Pinte sua skin em 2D com o boneco 3D ao vivo: camadas, espelhar, círculos, ajustes de cor, atalhos de teclado e rascunho automático."/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="12" Padding="16" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📦  Criador de modpacks" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5"
                                                       Margin="0,6,0,0" Text="Monte modpacks com o nome, a versão e o loader que quiser, guarde seus mods e abra o Minecraft direto por eles."/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="12" Padding="16" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🖼  Ícones exclusivos" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5"
                                                       Margin="0,6,0,0" Text="Troque o ícone do aplicativo e a mini lua do launcher por 6 desenhos: Redstone, Anjo, Mel, Órbita, Obsidiana e Rei."/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="12" Padding="16" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="✨  Animações douradas" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" FontSize="12.5"
                                                       Margin="0,6,0,0" Text="Uma entrada especial toda vez que você abre esta aba e uma explosão de estrelas quando o Golden Moon é ativado."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="GoldenActionTitle" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="GoldenActionDesc" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                               FontSize="12.5" Margin="0,6,0,14"/>
                                    <Grid x:Name="GoldenCodeRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GoldenCodeBox" Style="{StaticResource MoonTextBox}" Margin="0,0,10,0"
                                                 MaxLength="24" ToolTip="Ex.: ABCD-EFGH-JKLM-NPQR"/>
                                        <Button Grid.Column="1" Style="{StaticResource PlayButton}" Content="Ativar" FontSize="14"
                                                Padding="22,10" Margin="0" Click="GoldenActivate_Click"/>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="GoldenSubscribeBtn" Style="{StaticResource GhostButton}" Content="⭐  Assinar o Golden Moon"
                                                Click="GoldenSubscribe_Click"/>
                                        <Button x:Name="GoldenCustomizeBtn" Style="{StaticResource PlayButton}" Content="🎨  Personalizar minhas paletas"
                                                FontSize="14" Padding="18,9" Margin="0,0,10,0" Click="GoldenCustomize_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="✨  Ver os benefícios" Click="GoldenReplay_Click"/>
                                        <Button x:Name="GoldenRemoveBtn" Style="{StaticResource GhostButton}" Content="Remover do meu PC"
                                                Click="GoldenRemove_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="GoldenMsg" TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0"
                                               Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!-- ================= ANIMAÇÃO DO GOLDEN MOON (entrada na aba e ativação) ================= -->
            <Border x:Name="GoldenFx" Visibility="Collapsed" Opacity="0" CornerRadius="20" Cursor="Hand"
                    MouseLeftButtonDown="GoldenFx_Click">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.95" RadiusY="0.95">
                        <GradientStop Color="#F4241706" Offset="0"/>
                        <GradientStop Color="#F40C0812" Offset="0.62"/>
                        <GradientStop Color="#F6040309" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <Grid x:Name="GoldenFxHost" ClipToBounds="True"/>
            </Border>

            <!-- ================= POPUP (avisos e erros) ================= -->
            <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}"
                  IsVisibleChanged="Overlay_IsVisibleChanged">
                <Border x:Name="PopupCard" Style="{StaticResource Card}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource AccB1_55}"
                        MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="40" Padding="26" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="PopupTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PopupMessage" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text2Brush}" FontSize="13.5"/>
                        <Border x:Name="PopupDetailsBox" Background="{DynamicResource DetailsBrush}" CornerRadius="8" Margin="0,14,0,0"
                                Padding="10" Visibility="Collapsed">
                            <TextBox x:Name="PopupDetails" IsReadOnly="True" Background="Transparent"
                                     BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"
                                     Foreground="{DynamicResource Text2Brush}" MaxHeight="170" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <StackPanel x:Name="PopupButtons" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Clarão branco da animação ao abrir o Minecraft -->
            <Border x:Name="FlashOverlay" Background="White" CornerRadius="20" Opacity="0"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- ================= ABERTURA: janela branca tremendo + brilhinhos ================= -->
            <Grid x:Name="Splash">
                <!-- A "aba" do launcher inteira, branca -->
                <Border CornerRadius="19">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F1EEFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel x:Name="SplashContent" VerticalAlignment="Center" HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="SplashContentS" ScaleX="1" ScaleY="1"/>
                    </StackPanel.RenderTransform>
                    <!-- A luazinha da abertura foi removida: fica só a janela branca tremendo.
                         (Os elementos continuam aqui, escondidos, porque o código troca o ícone deles.) -->
                    <Grid Width="170" Height="170" Visibility="Collapsed">
                        <Ellipse x:Name="SplashGlow" Width="340" Height="340" Opacity="0" IsHitTestVisible="False"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource Acc1_66}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Acc2_00}" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="SplashGlowS" ScaleX="0.9" ScaleY="0.9"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Image x:Name="SplashMoon" Source="Assets/logo.png" Width="130" Height="130" Opacity="0"
                               RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SplashMoonS" ScaleX="0.8" ScaleY="0.8"/>
                                    <TranslateTransform x:Name="SplashMoonT"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <TextBlock x:Name="SplashStatus" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Brilhinhos que saem dos menus quando eles aparecem -->
            <Canvas x:Name="IntroSparkles" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
