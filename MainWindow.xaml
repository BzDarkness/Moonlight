                                            <ListBox x:Name="PackModsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                                                     ItemContainerStyle="{StaticResource InstalledModItem}"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" Padding="9,3"
                                                                    Margin="0" Tag="{Binding}" ToolTip="Tirar do modpack"
                                                                    Click="PackRemoveMod_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="PackModsEmpty" Visibility="Collapsed" Foreground="{DynamicResource Muted}"
                                                       FontSize="12.5" TextWrapping="Wrap" Margin="4,6,0,0"
                                                       Text="Nenhum mod ainda. Clique em “Adicionar mods” para escolher."/>
                                        </Grid>
                                        <TextBlock x:Name="PackStatus" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
