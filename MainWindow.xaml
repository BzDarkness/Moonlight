                                            <Button Style="{StaticResource GhostButton}" Content="➕  Adicionar mods" Margin="0,0,8,8"
                                                    Click="PackAddMods_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="📁  Abrir pasta" Margin="0,0,8,8"
                                                    Click="PackFolder_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="🗑  Apagar modpack" Margin="0,0,8,8"
                                                    Click="PackDelete_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="PackModsTitle" Text="MODS DESTE MODPACK" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}" Margin="2,8,0,8"/>
