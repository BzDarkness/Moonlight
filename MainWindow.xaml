                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccB1_55}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccB1_FF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
