                                </Border>

                                <TextBlock x:Name="PackHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13.5"
                                           Margin="6,10,0,0"
                                           Text="Escolha um modpack na lista ou crie um novo. Eles ficam guardados aqui na aba Mods e você pode abrir o Minecraft direto por eles."/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Trava: o criador de modpacks só abre com o Golden Moon ativo -->
                        <Border x:Name="PackLock" Grid.ColumnSpan="2" CornerRadius="16" Background="{DynamicResource PopupBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" MaxWidth="440">
                                <Image Source="Assets/golden_moon.png" Width="76" Height="76" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="🔒  O criador de modpacks é exclusivo do Golden Moon" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,6"/>
                                <TextBlock Text="Crie modpacks com o nome, a versão e o loader que quiser, guarde seus mods e abra o jogo direto por eles."
                                           FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource PlayButton}" Content="⭐  Conhecer o Golden Moon" FontSize="13"
                                        Padding="20,10" HorizontalAlignment="Center" Click="GoldenLock_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Grid>

                    <!-- Setinha na borda direita: abre e fecha a gaveta de mods instalados -->
                    <Button x:Name="DrawerHandle" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-24,0"
                            Width="22" Height="92" Panel.ZIndex="20" Cursor="Hand" Focusable="False"
                            ToolTip="Mods instalados" Click="DrawerHandle_Click">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="HandleT"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="11" Background="{DynamicResource SurfaceHiBrush}"
                                        BorderBrush="{DynamicResource AccB1_80}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccB1_FF}"/>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccB1_33}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 6,1 L 1,6 L 6,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" Margin="0,0,0,8" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="HandleArrowRot"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="DrawerCount" Text="0" FontSize="11" FontWeight="Bold" TextAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="🧩" FontSize="10" TextAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>


                    <!-- ================= PÁGINA: CONTAS ================= -->
                    <Grid x:Name="PageAccounts" Grid.Row="1" Margin="26,0,26,22" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SUAS CONTAS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" Margin="4,0,0,4"/>
                            <TextBlock Text="Clique em uma conta para usá-la." FontSize="12"
                                       Foreground="{DynamicResource Muted}" Margin="4,0,0,12"/>
                        </StackPanel>
                        <ListBox x:Name="AccountList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource AccountItem}"
                                 SelectionChanged="AccountList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="6" Padding="8,2" Background="{DynamicResource AccB1_33}"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Content="🗑  Remover conta selecionada" Click="RemoveAccount_Click"/>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Conta Microsoft (Minecraft original)" FontSize="17" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="0,6,0,14"
                                           Text="Entre com a conta que comprou o Minecraft Java. Necessária para servidores originais e para usar sua skin oficial."/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PlayButton}" Content="Entrar com Microsoft"
                                            FontSize="14" Padding="20,10" Margin="0,0,10,8" Click="MicrosoftLogin_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Criar conta Microsoft"
                                            Margin="0,0,8,8" Click="MicrosoftSignup_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Comprar Minecraft"
                                            Margin="0,0,8,8" Click="BuyMinecraft_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="MsStatus" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Conta Moonlight (sem e-mail)" FontSize="17" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="0,6,0,14"
                                           Text="Crie seu perfil só com um nome. Guarde várias skins do NameMC e troque com um clique na aba Skins. Funciona no modo solo e em servidores sem verificação de conta (offline-mode)."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OfflineBox" Style="{StaticResource MoonTextBox}"
                                             ToolTip="3 a 16 caracteres: letras, números ou _" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PlayButton}" Content="Criar e usar"
                                            FontSize="14" Padding="20,10" Margin="0" Click="AddOffline_Click"/>
                                </Grid>
                                <TextBlock x:Name="OfflineStatus" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>


                    <!-- ================= PÁGINA: SKINS ================= -->
                    <Grid x:Name="PageSkins" Grid.Row="1" Margin="26,0,26,22" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Style="{StaticResource NavTab}" GroupName="skintab" Tag="mine" IsChecked="True"
                                         Content="🎭  Minhas skins" Checked="SkinTab_Checked"/>
                            <RadioButton x:Name="SkinEditorTab" Style="{StaticResource NavTab}" GroupName="skintab" Tag="editor"
                                         Content="🎨  Criador de skin" Checked="SkinTab_Checked"/>
                        </StackPanel>
                        <Grid x:Name="SkinsMain" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,18,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="SKIN DA CONTA" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                            <Grid Grid.Row="1" ClipToBounds="True">
                                <Ellipse Width="260" Height="260" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{DynamicResource Acc1_4C}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource Acc1_00}" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="180" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,26" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{DynamicResource Acc2_99}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource Acc2_00}" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <local:SkinViewer3D x:Name="SkinView"/>
                                <TextBlock x:Name="SkinNoneText" Text="Sem skin ainda — busque uma ao lado ✨"
                                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Center" FontSize="11.5" Margin="8,0,8,2"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock x:Name="SkinAccountText" TextAlignment="Center" FontSize="13"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Mexa o mouse: ele te acompanha 👀" TextAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Escolher a skin" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                               Margin="0,6,0,14"
                                               Text="Digite um nick, um link do NameMC (perfil ou skin), um UUID ou um link .png. Ou escolha um arquivo do seu PC."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SkinSourceBox" Style="{StaticResource MoonTextBox}" Margin="0,0,10,0"
                                                 ToolTip="Ex.: Notch, namemc.com/profile/Notch.1 ou namemc.com/skin/6e8a6d2c80f9e54b"/>
                                        <Button x:Name="SkinImportBtn" Grid.Column="1" Style="{StaticResource PlayButton}"
                                                Content="Buscar skin" FontSize="14" Padding="20,10" Margin="0"
                                                Click="ImportSkin_Click"/>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="SkinPickBtn" Style="{StaticResource GhostButton}"
                                                Content="📂  Escolher arquivo .png" Margin="0,0,8,8" Click="PickSkinFile_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="🌐  Abrir o NameMC"
                                                Margin="0,0,8,8" Click="OpenNameMc_Click"/>
                                        <Button x:Name="SkinRemoveBtn" Style="{StaticResource GhostButton}"
                                                Content="🗑  Remover skin" Margin="0,0,8,8" Click="RemoveSkin_Click"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="SkinSlimCheck" Content="Braços finos (modelo Alex)"
                                              Foreground="{DynamicResource TextStrongBrush}" FontSize="12.5" Margin="2,4,0,0"
                                              Checked="SkinSlim_Changed" Unchecked="SkinSlim_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Minha biblioteca" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                               Margin="0,6,0,12"
                                               Text="Toda skin que você busca ou escolhe fica guardada aqui. Selecione uma e clique em Usar para trocar na hora."/>
                                    <Grid MinHeight="40">
                                        <ListBox x:Name="SkinLibList" Background="Transparent" BorderThickness="0"
                                                 MaxHeight="170" ItemContainerStyle="{StaticResource AccountItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" FontSize="14"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="SkinLibEmpty" Text="Ainda não tem skins guardadas."
                                                   Foreground="{DynamicResource Muted}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource PlayButton}" Content="✔  Usar esta skin" FontSize="14"
                                                Padding="20,10" Margin="0,0,10,0" Click="UseLibrarySkin_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="🗑  Apagar da biblioteca"
                                                Margin="0" Click="DeleteLibrarySkin_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Usar no jogo" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="SkinModeText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                               FontSize="12.5" Margin="0,6,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="SkinUploadBtn" Style="{StaticResource PlayButton}"
                                                Content="⬆  Enviar para a Mojang" FontSize="14" Padding="20,10"
                                                Margin="0,0,10,8" Click="UploadSkin_Click"/>
                                        <Button x:Name="SkinMyNameMcBtn" Style="{StaticResource GhostButton}"
                                                Content="Ver meu perfil no NameMC" Margin="0,0,8,8" Click="OpenMyNameMc_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="SkinStatus" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                        </Grid>
                        <local:SkinEditor x:Name="SkinEditorView" Grid.Row="1" Visibility="Collapsed"/>

                        <!-- Trava: o criador de skin só abre com o Golden Moon ativo -->
                        <Border x:Name="SkinEditorLock" Grid.Row="1" Visibility="Collapsed" CornerRadius="16"
                                Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" MaxWidth="460">
                                <Image Source="Assets/golden_moon.png" Width="88" Height="88" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="🔒  O criador de skin é exclusivo do Golden Moon" FontSize="17" FontWeight="Bold"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,6"/>
                                <TextBlock Text="Pinte sua skin em 2D com o boneco 3D ao vivo, camadas, espelhar, ajustes de cor e rascunho automático."
                                           FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource PlayButton}" Content="⭐  Conhecer o Golden Moon" FontSize="13"
                                        Padding="20,10" HorizontalAlignment="Center" Click="GoldenLock_Click"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ================= PÁGINA: PASTAS ================= -->
                    <StackPanel x:Name="PageFolders" Grid.Row="1" Margin="26,0,26,22" Visibility="Collapsed">
                    <TextBlock Text="PASTAS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" Margin="4,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,7,14">
                            <StackPanel>
                                <TextBlock Text="🧩  Pasta de mods" FontSize="17" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="0,6,0,14" Text="Coloque aqui os arquivos .jar dos seus mods (Forge, Fabric ou NeoForge)."/>
                                <Button Style="{StaticResource PlayButton}" Content="Abrir pasta de mods" Tag="mods"
                                        FontSize="14" Padding="20,10" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🌍  Pasta do Minecraft" FontSize="17" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="0,6,0,14" Text="A pasta raiz do jogo: mundos, shaders, texturas, configurações e mais."/>
                                <Button Style="{StaticResource PlayButton}" Content="Abrir pasta do Minecraft" Tag=""
                                        FontSize="14" Padding="20,10" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="ATALHOS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" Margin="4,6,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Content="🗺  Mundos" Tag="saves" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="✨  Shaders" Tag="shaderpacks" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="🖼  Texturas" Tag="resourcepacks" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="📜  Logs" Tag="logs" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="💥  Relatórios de crash" Tag="crash-reports" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="🧾  Log do launcher" Click="OpenLauncherLog_Click"/>
                    </WrapPanel>
                </StackPanel>

                    <!-- ================= PÁGINA: AJUSTES ================= -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Margin="26,0,12,22" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <WrapPanel Margin="0,0,0,14">
                                <RadioButton x:Name="SettingsTabGeneral" Style="{StaticResource PillButton}" GroupName="settab" Tag="General"
                                             Content="⚙  Geral" FontSize="13.5" Padding="16,8"/>
                                <RadioButton x:Name="SettingsTabCustomize" Style="{StaticResource PillButton}" GroupName="settab" Tag="Customize"
                                             Content="🎨  Personalizar" FontSize="13.5" Padding="16,8"/>
                            </WrapPanel>

                            <StackPanel x:Name="SettingsGeneral">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="⚡  Desempenho" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                               Margin="0,6,0,14"
                                               Text="O modo Automático liga o visual leve sozinho em PCs mais fracos. Você pode forçar um dos dois."/>
                                    <WrapPanel x:Name="PerfPanel">
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Auto" GroupName="perf"
                                                     Content="🤖  Automático" Checked="PerfMode_Checked"/>
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Full" GroupName="perf"
                                                     Content="✨  Completo" Checked="PerfMode_Checked"/>
                                        <RadioButton Style="{StaticResource LoaderButton}" Tag="Light" GroupName="perf"
                                                     Content="🍃  Leve" Checked="PerfMode_Checked"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="PerfInfo" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" Margin="2,6,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PerfMemText" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" Margin="2,4,0,0"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource PlayButton}" Content="🧹  Liberar memória agora"
                                                FontSize="14" Padding="18,9" Margin="0,0,10,8" Click="FreeMemory_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="🗑  Limpar cache do launcher"
                                                Margin="0,0,8,8" Click="ClearCache_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="CacheInfo" FontSize="12" Foreground="{DynamicResource Muted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="🖥  Atalho na área de trabalho" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Manter o atalho" FontSize="12" Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ToggleButton x:Name="ShortcutToggle" Style="{StaticResource ModSwitch}" Click="ShortcutToggle_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,6,0,10"
                                               Text="Na primeira vez que abre, o launcher se guarda numa pasta escondida do Windows e deixa só este atalho na sua área de trabalho (o .exe baixado é apagado). As atualizações também acontecem lá, sem sujar a área de trabalho. Se você trocar o ícone do aplicativo (Golden Moon), o ícone do atalho muda junto. Se você apagar o atalho, ele não volta sozinho."/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource GhostButton}" Content="🖥  Criar atalho agora"
                                                Margin="0,0,8,8" Click="ShortcutNow_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ShortcutInfo" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="🔄  Atualizações" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
