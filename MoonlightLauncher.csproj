<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MoonlightLauncher</RootNamespace>
    <AssemblyName>MoonlightLauncher</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.6.2</Version>
    <!-- ATENÇÃO: não use InvariantGlobalization=true. O WPF precisa da cultura "en-us" para montar os
         templates dos controles; com ela ligada dá XamlParseException e os menus/listas/skins quebram. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Abre mais rápido: o código já sai pré-compilado no .exe (só vale ao publicar com -r win-x64). -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.*" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.*" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.*" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.*" />
  </ItemGroup>

  <!-- O GitHub Actions passa -p:UpdateRepo=dono/repositorio; o launcher lê daqui onde procurar Releases. -->
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="GitHubRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\golden_moon.png" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icons\*.png" />
    <Resource Include="Assets\versions\*.png" />
  </ItemGroup>

</Project>
